        <mxCell id="c66" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#525866;fontStyle=1;" value="VISIE" vertex="1">
          <mxGeometry height="20" width="171" x="1235" y="130" as="geometry" />
        </mxCell>
        <mxCell id="c67" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fillColor=#DCE8F5;strokeColor=#1D5FA8;fontColor=#15181E;align=left;verticalAlign=top;spacing=14;fontSize=13;" value="&lt;b style=&quot;font-size:16px&quot;&gt;Visie — waarom (kompas)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Samen werken we voor de gebruiker; die moet senang zijn, nu en later.&lt;br&gt;Dat wordt hij door het product te gebruiken.&lt;br&gt;Het product ontstaat uit intentie en proces, in balans.&lt;br&gt;Wat het gebruik ons leert, voedt de volgende intentie.&lt;br&gt;Het product is nooit af." vertex="1">
          <mxGeometry height="200" width="360" x="1235" y="158" as="geometry" />
        </mxCell>
        <mxCell id="deliv_box" parent="1" vertex="1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15181E;strokeWidth=2;"><mxGeometry x="1220" y="378" width="390" height="540" as="geometry" /></mxCell><mxCell id="c68" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E3F1EA;strokeColor=#1F7A5A;fontColor=#15181E;align=left;verticalAlign=top;spacing=14;fontSize=13;" value="&lt;b style=&quot;font-size:16px&quot;&gt;     Het FCD-model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eén taal: de bouwstenen van jouw FCD, beschreven en per perspectief geplaatst. Business, IT en teams praten over hetzelfde. Met twee voorbeelden: klassiek en DevOps." vertex="1">
          <mxGeometry height="148" width="340" x="1254" y="426" as="geometry" />
        </mxCell>
        <mxCell id="c69" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FBEADF;strokeColor=#A84A14;fontColor=#15181E;align=left;verticalAlign=top;spacing=14;fontSize=13;" value="&lt;b style=&quot;font-size:16px&quot;&gt;     Jouw FCD-model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Door vraag en antwoord: waar je staat, waar je heen wilt en welk perspectief aandacht nodig heeft. Vastgelegd in een declaratief bestand: wat en waarom, reproduceerbaar." vertex="1">
          <mxGeometry height="148" width="340" x="1254" y="590" as="geometry" />
        </mxCell>
        <mxCell id="c70" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ECE6F5;strokeColor=#5B3E96;fontColor=#15181E;align=left;verticalAlign=top;spacing=14;fontSize=13;" value="&lt;b style=&quot;font-size:16px&quot;&gt;     Jouw FCD-model als werkende showcase&lt;/b&gt;&lt;br&gt;&lt;br&gt;Je ziet hoe het kan werken en waar wijzigingen nodig zijn." vertex="1">
